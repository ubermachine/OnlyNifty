# Python bytecode
__pycache__/
*.py[cod]
*$py.class
*.pyc

# Virtual environments
venv/
.venv/
env/

# Cache directories
.cache/
.cache_test/
.pytest_cache/
.coverage
data/test_*.json

# Secrets
.secrets/*
!.secrets/*.example.json
.env
.streamlit/secrets.toml
.streamlit/*.toml

# OS generated
.DS_Store
Thumbs.db

# Mutable runtime state buffers (rewritten per autorefresh)
data/*.tmp.*
data/*.tmp
data/signals_journal_today.json
data/risk_state_today.json
data/options_state.json

# Immutable daily archives & derived analytics ARE tracked
!data/archive/
!data/archive/*.jsonl
!data/edge_table.json
data/premium_pending.jsonl
data/premium_resolved.jsonl
data/edge_table_model.json
data/bhavcopy/
